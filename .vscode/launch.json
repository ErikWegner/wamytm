{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django Server",
            "type": "python",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "program": "${workspaceFolder}/src/manage.py",
            "args": [
                "runserver",
                "0.0.0.0:8000",
                "--noreload"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "wamytmsite.settings.dev",
                "DEBUG": "1"
            },
            "envFile": "${workspaceFolder}/${input:envFile}",
            "django": true,
            "justMyCode": false
        },
        {
            "name": "Django migrate",
            "type": "python",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "program": "${workspaceFolder}/src/manage.py",
            "args": [
                "migrate"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "wamytmsite.settings.dev",
                "DEBUG": "TRUE"
            },
            "envFile": "${workspaceFolder}/${input:envFile}",
            "django": true,
            "justMyCode": false
        }
    ],
    "inputs": [
        {
            "id": "envFile",
            "type": "pickString",
            "description": "Wähle die Env-Datei für die Konfiguration",
            "options": [
                ".env_dev",
                ".env_test",
                ".env_prod"
            ],
            "default": ".env_dev"
        }
    ]
}